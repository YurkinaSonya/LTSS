              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) { pm.environment.set('runToken', data.token); }",
                  "  if (data.run && data.run.runId) { pm.environment.set('runId', data.run.runId); }",
                  "}"
