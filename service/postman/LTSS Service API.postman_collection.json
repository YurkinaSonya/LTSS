        {
          "name": "Generate Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (Array.isArray(data) && data.length > 0) {",
                  "    pm.environment.set('participantLogin', data[0].login);",
                  "    pm.environment.set('participantPassword', data[0].plainPassword);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 3,\n  \"assignedGroupStrategy\": \"ROUND_ROBIN\",\n  \"prefix\": \"pilot\",\n  \"groupCodes\": [\"control\", \"nudge-a\"],\n  \"defaultAssignedConfigJson\": \"{\\\"uiTheme\\\":\\\"default\\\",\\\"difficultyTier\\\":1}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/session-definitions/{{sessionDefinitionId}}/generate-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "session-definitions",
                "{{sessionDefinitionId}}",
                "generate-accounts"
              ]
            },
            "description": "Генерация тестовых учёток. Первая пара login/password сохранится в environment."
          }
